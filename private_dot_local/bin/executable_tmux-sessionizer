#!/usr/bin/env bash
# Usage:
#   tmux-sessionizer              pick a project dir with fzf, open or switch to its session
#   tmux-sessionizer <dir|name>   same, for that dir (a name is fuzzy-matched like the picker)
#   tmux-sessionizer -d <dir|name>
#       detached: create the session if it's missing, print its name, and don't switch
#       any client or touch the picker history. For agents (e.g. Ada) running outside tmux.

HISTORY_FILE="$HOME/.local/share/tmux-sessionizer-history"
touch "$HISTORY_FILE"

detached=0
if [[ ${1:-} == "-d" ]]; then
    detached=1
    shift
fi

# Every dir the picker offers: ~/Code projects plus extra non-Code dirs
# (scratch/reading dirs). Extras are only included if they exist — keeps the
# list clean on machines (e.g. the Mac Mini) where the Synology wiki mount isn't present.
candidate_dirs() {
    local extra_dirs=(
        "$HOME/Downloads"
        "$HOME/Library/CloudStorage/SynologyDrive-Caretakers/brain/wiki"
    )
    local existing_extra=() d
    for d in "${extra_dirs[@]}"; do
        [[ -d $d ]] && existing_extra+=("$d")
    done
    { find ~/Code -mindepth 1 -maxdepth 1 -type d; printf '%s\n' "${existing_extra[@]}"; } | sort
}

if [[ $# -eq 1 ]]; then
    selected=$1
    if [[ ! -d $selected ]]; then
        # Exact project name first, then the best fuzzy match, as the picker would rank it.
        if [[ -d "$HOME/Code/$selected" ]]; then
            selected="$HOME/Code/$selected"
        else
            selected=$(candidate_dirs | fzf --filter "$1" | head -n 1)
        fi
    fi
else
    all_dirs=$(candidate_dirs)
    # Dirs ordered by most recently sessionized (most recent last).
    # Filter to dirs that still exist so deleted/trashed paths (which would
    # otherwise resurrect a stale same-named session) never appear.
    ranked=$(tac "$HISTORY_FILE" | awk '!seen[$0]++' | while IFS= read -r d; do
        [[ -d $d ]] && printf '%s\n' "$d"
    done)
    # Unranked dirs go at the top
    unranked=$(comm -23 <(echo "$all_dirs") <(echo "$ranked" | sort))
    selected=$(printf '%s\n%s' "$unranked" "$(echo "$ranked" | tac)" | grep -v '^$' | fzf --tac)
fi

if [[ -z $selected || ! -d $selected ]]; then
    [[ $detached -eq 1 ]] && { echo "tmux-sessionizer: no project matches '${1:-}'" >&2; exit 1; }
    exit 0
fi

# Log this selection (only Alex's own picks shape the picker order)
[[ $detached -eq 0 ]] && echo "$selected" >> "$HISTORY_FILE"

selected_name=$(basename "$selected" | tr . _)

if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected" -n code
    tmux send-keys -t "$selected_name:code" "nvim" Enter
    tmux new-window -t "$selected_name" -n agents -c "$selected"
    tmux split-window -t "$selected_name:agents" -h -c "$selected"
    tmux new-window -t "$selected_name" -n processes -c "$selected"
    tmux split-window -t "$selected_name:processes" -h -c "$selected"
    tmux split-window -t "$selected_name:processes" -v -c "$selected"
    tmux select-pane -t "$selected_name:processes.1"
    tmux select-window -t "$selected_name:code"
fi

if [[ $detached -eq 1 ]]; then
    echo "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
